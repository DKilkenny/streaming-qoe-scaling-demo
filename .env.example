# Copy to .env and fill in. .env is gitignored.

# AI incident explainer (optional). Without a key, the explainer falls back to a
# deterministic rule-based reading of the metrics, so the demo still works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# OpenTelemetry tracing. On by default so traces flow to Jaeger.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Base URL for the Console's Grafana deep-link. Leave unset for local dev
# (defaults to https://localhost). On a prod VM that exposes Grafana, set it to
# the grafana sslip.io host, e.g. https://grafana.157-230-196-166.sslip.io .
# Set it explicitly empty (GRAFANA_BASE=) to hide the Grafana link entirely.
# GRAFANA_BASE=
